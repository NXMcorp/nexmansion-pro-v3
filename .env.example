# Database - file path for SQLite (local dev) or Postgres URL for production
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="replace-me-with-a-strong-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (optional - works in test mode with key, otherwise demo flow)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Email (development adapter logs to console when empty)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="concierge@nexmansion.com"

# Feature flags (default off for future features)
FEATURE_CRYPTO_PAYMENTS="false"
FEATURE_NEXCOIN="false"
FEATURE_AI_CONCIERGE="false"
FEATURE_AR_VR="false"
